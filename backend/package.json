{
    "name": "backend",
    "version": "1.0.0",
    "description": "backend for claro application",
    "author": "Mateus Duarte",
    "private": true,
    "license": "UNLICENSED",
    "engines": {
        "node": "24.22.1",
        "yarn": "please use npm",
        "npm": "12.2.1"
    },
    "scripts": {
        "build": "nest build",
        "deploy": "nest deploy",
        "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
        "typeorm": "node --require ts-node/register ./node_modules/typeorm/cli.js",
        "migration:generate": "npm run typeorm -- migration:generate -d src/database/DataSource.ts",
        "seed": "npm run typeorm -- migration:run -d src/database/DataSource.ts",
        "migration:revert": "npm run typeorm -- migration:revert -d src/database/DataSource.ts",
        "start": "nest start --watch",
        "start:debug": "nest start --debug --watch",
        "start:prod": "node dist/main",
        "lint": "oxlint --type-aware src/ test/",
        "test": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js",
        "test:watch": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --watch",
        "test:cov": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --coverage",
        "test:debug": "node --inspect-brk --experimental-vm-modules -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
        "test:e2e": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --config ./test/jest-e2e.json"
    },
    "dependencies": {
        "@nestjs/common": "12.3.2",
        "@nestjs/core": "12.3.2",
        "@nestjs/platform-express": "12.3.2",
        "@nestjs/schedule": "12.0.2",
        "@nestjs/swagger": "12.0.5",
        "@nestjs/typeorm": "12.0.2",
        "class-transformer": "0.5.1",
        "class-validator": "0.15.1",
        "dotenv": "18.0.9",
        "pg": "8.23.1",
        "reflect-metadata": "0.2.2",
        "rxjs": "7.8.2",
        "typeorm": "1.1.2"
    },
    "devDependencies": {
        "@nestjs/cli": "12.0.11",
        "@nestjs/mau": "0.2.9",
        "@nestjs/schematics": "12.0.12",
        "@nestjs/testing": "12.3.2",
        "@types/express": "5.0.6",
        "@types/jest": "30.0.0",
        "@types/node": "26.6.6",
        "@types/supertest": "7.2.1",
        "jest": "30.5.2",
        "oxlint": "1.90.0",
        "oxlint-tsgolint": "7.0.2005",
        "prettier": "3.9.10",
        "source-map-support": "0.5.21",
        "supertest": "7.3.1",
        "ts-jest": "29.4.15",
        "ts-loader": "9.6.2",
        "ts-node": "10.9.2",
        "tsconfig-paths": "4.2.0",
        "typeorm-ts-node-commonjs": "0.3.20",
        "typescript": "6.0.2"
    }
}
